/* OceanScene.css */

#ocean-section {
  position: relative;
  overflow: hidden;
}

.text-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
}

.slide {
  position: absolute;
  text-align: center;
  opacity: 0;
}

.slide-title {
  font-size: clamp(2rem, 5vw, 4rem);
  color: white;
  margin-bottom: 0.5rem;
}

.slide-sub {
  font-size: clamp(1rem, 2.5vw, 1.5rem);
  color: rgba(255,255,255,0.85);
}
